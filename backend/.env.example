# Database — өөрийн компьютерийн PostgreSQL тохиргоо
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pi_too
DB_USER=postgres
DB_PASSWORD=ЭНД_ӨӨРИЙН_POSTGRES_НУУЦ_ҮГЭЭ_БИЧНЭ

# Server — frontend 3001 хаягийг хүлээдэг тул ЗААВАЛ 3001
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# QPay (заавал биш — бодит төлбөр туршихад л хэрэгтэй)
QPAY_USERNAME=your_qpay_username
QPAY_PASSWORD=your_qpay_password
QPAY_INVOICE_CODE=your_invoice_code
